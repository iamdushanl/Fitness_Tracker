# ==============================================================================
# Fitness Tracker Frontend — Environment Variables Template
# ==============================================================================
# Copy this file to "frontend/.env.local" for Vite local development.
# In production (Vercel), configure these in Project Settings -> Environment Variables.
#
# NOTE: All frontend variables MUST begin with "VITE_" to be accessible in browser code.
#       NEVER place secret keys (e.g. service_role, private API tokens) here!
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for browser, governed by Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API base URL (local Express server or deployed AWS App Runner domain)
VITE_API_URL=http://localhost:8000
