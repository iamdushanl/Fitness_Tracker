# ==============================================================================
# Fitness Tracker Backend — Environment Variables Template
# ==============================================================================
# Copy this file to "backend/.env" for standalone backend development.
# NEVER commit "backend/.env".
# In production (AWS App Runner / ECS), secrets are injected from AWS Secrets Manager.
# ==============================================================================

# HTTP port the Express server listens on (default: 8000)
PORT=8000

# Node runtime environment (development, test, production)
NODE_ENV=development

# Supabase Project URL for server-side queries and token verification
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (CRITICAL SECRET: bypasses RLS, keep secure)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Allowed origins for CORS (e.g. '*' in dev, or https://your-app.vercel.app in prod)
CORS_ORIGIN=*

# Optional: API key for LLM-based workout insights / coach generation
# AI_API_KEY=your-ai-api-key-here
