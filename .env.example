# ==============================================================================
# Fitness Tracker Monorepo — Environment Variables Template
# ==============================================================================
# Copy this file to ".env" for local unified development. NEVER commit ".env".
# For full specifications, see docs/CONFIG_AND_SECRETS.md
#
# RULE: Variables starting with "VITE_" are PUBLIC and bundled into browser JS.
#       All other variables are PRIVATE and must only be accessed by Node.js.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Client-side / Vercel) — SAFE to expose to the browser
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (browser-safe, protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API base URL for client HTTP requests (e.g. http://localhost:8000 in dev, or AWS App Runner URL in prod)
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Backend (Server-side / AWS App Runner / Docker) — SERVER ONLY, KEEP SECRET
# ------------------------------------------------------------------------------

# HTTP port the Express server listens on (default: 8000)
PORT=8000

# Node runtime environment (development, test, production)
NODE_ENV=development

# Supabase Project URL for server-side queries and token verification
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (CRITICAL SECRET: bypasses RLS, NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Allowed origins for CORS (e.g. '*' for local dev, or https://your-app.vercel.app for production)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------

# API key for LLM-based workout insights / coach generation (keep secret)
# AI_API_KEY=your-ai-api-key-here
